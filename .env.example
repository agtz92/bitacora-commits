# Variables de entorno (en Vercel: Project → Settings → Environment Variables).

# Postgres. En Supabase usa el pooler en modo transacción (puerto 6543) con el rol bitacora_app.
DATABASE_URL=postgresql://bitacora_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Token de GitHub de solo lectura (ver README, sección "Token").
GITHUB_TOKEN=

# Contraseña para entrar a la página web.
APP_PASSWORD=
# Firma las cookies de sesión. Cualquier texto largo y aleatorio.
SESSION_SECRET=
# El MCP vive en https://<tu-dominio>/mcp/<MCP_SECRET>. Texto largo y aleatorio.
MCP_SECRET=

# Opcionales
SINCE=2025-01-01
TIMEZONE=America/Mexico_City
BOT_AUTHORS=github-actions[bot],github-classroom[bot],Vercel,dependabot[bot]
INCLUDE_FORKS=true
EXCLUDE_REPOS=
SYNC_WORKERS=6
SYNC_BUDGET_SECONDS=40
