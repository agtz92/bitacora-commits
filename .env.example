# Token de GitHub de solo lectura (ver README, sección "Token").
GITHUB_TOKEN=

# Puerto en tu Mac: http://localhost:8787
PORT=8787

# Solo se guardan commits a partir de esta fecha.
SINCE=2025-01-01
TIMEZONE=America/Mexico_City

# Autores que cuentan como bots (se excluyen por defecto en matriz y resumen).
BOT_AUTHORS=github-actions[bot],github-classroom[bot],Vercel,dependabot[bot]

# Incluir forks (los repos de GitHub Classroom del Tec son forks).
INCLUDE_FORKS=true
# Repos a ignorar, separados por coma (nombre o owner/nombre).
EXCLUDE_REPOS=

# 0 = solo on-demand (botón o CLI). Ej. 24 = además revisa sola cada 24 h.
AUTO_SYNC_HOURS=0
SYNC_WORKERS=4

# Opcional: protege la página con usuario y contraseña (recomendado si la abres fuera de tu Mac).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
